# Sec-Llama MCP Server Environment Configuration
# Copy this file to .env.mcp and customize for your environment

# ==============================================================================
# MCP Server Configuration
# ==============================================================================

# Host and Port
MCP_HOST=0.0.0.0
MCP_PORT=8765

# API Keys (comma-separated)
# Generate with: openssl rand -hex 32
# Or: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEYS=your_admin_key_here,your_readonly_key_here

# ==============================================================================
# Ollama Configuration
# ==============================================================================

# Ollama API endpoint
OLLAMA_HOST=http://localhost:11434

# Default model to use
OLLAMA_MODEL=llama3.1:8b

# Ollama timeout (seconds)
OLLAMA_TIMEOUT=120

# ==============================================================================
# Logging
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/mcp_server.log

# ==============================================================================
# Security
# ==============================================================================

# Enable authentication (true/false)
AUTH_ENABLED=true

# Maximum request size (in bytes)
MAX_REQUEST_SIZE=10485760  # 10 MB

# Tool execution timeout (seconds)
TOOL_TIMEOUT=300  # 5 minutes

# ==============================================================================
# Rate Limiting
# ==============================================================================

# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Default rate limit (requests per hour)
RATE_LIMIT_DEFAULT=100

# ==============================================================================
# Performance
# ==============================================================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=5

# Number of worker threads
WORKER_THREADS=4

# Enable caching (true/false)
CACHE_ENABLED=true

# Cache TTL (seconds)
CACHE_TTL=3600  # 1 hour

# ==============================================================================
# Development/Debug
# ==============================================================================

# Debug mode (true/false)
DEBUG=false

# Verbose logging (true/false)
VERBOSE=false

# ==============================================================================
# Docker-specific (when using docker-compose)
# ==============================================================================

# Network subnet for Docker
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Volume names
OLLAMA_VOLUME_NAME=sec-llama-ollama-models
