# ============================================================================
# Sec-Llama LAN Server - Environment Configuration
# ============================================================================
# Copy this file to .env and customize the values
# Usage: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
WEB_UI_PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# Security Keys (CHANGE THESE!)
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_DB=sec_llama
POSTGRES_USER=sec_llama
POSTGRES_PASSWORD=change-this-secure-database-password
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Redis Cache Configuration
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

# ----------------------------------------------------------------------------
# LLM Provider Configuration
# ----------------------------------------------------------------------------
# Choose provider: 'ollama' or 'lm-studio'
LLM_PROVIDER=ollama

# ===== OLLAMA CONFIGURATION (Remote Server) =====
# Set this to the IP:PORT of your Ollama server on LAN
OLLAMA_HOST=http://192.168.1.100:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# Available models (examples):
# - llama3.1:8b (faster, good for most tasks)
# - llama3.1:70b (better reasoning, slower)
# - mistral:latest
# - codellama:latest
# - mixtral:latest

# ===== LM STUDIO CONFIGURATION (Remote Server) =====
# LM Studio uses OpenAI-compatible API
# Set this to the IP:PORT of your LM Studio server
LM_STUDIO_HOST=http://192.168.1.100:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=not-needed

# LM Studio API path defaults to /v1
# If different, set: LM_STUDIO_API_PATH=/custom/path

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# Use * for development, specific domains for production
ALLOWED_ORIGINS=*

# Production example:
# ALLOWED_ORIGINS=http://192.168.1.10:8080,https://sec-llama.yourdomain.com

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------------------
# Network Configuration
# ----------------------------------------------------------------------------
# Subnet for Docker network (change if conflicts with your LAN)
DOCKER_SUBNET=172.28.0.0/16

# ----------------------------------------------------------------------------
# Optional: External Tools Integration
# ----------------------------------------------------------------------------
# Nmap path (if using host network mode)
# NMAP_PATH=/usr/bin/nmap

# Metasploit (if available)
# METASPLOIT_ENABLED=false
# METASPLOIT_PATH=/usr/bin/msfconsole

# ----------------------------------------------------------------------------
# Optional: Threat Intelligence APIs
# ----------------------------------------------------------------------------
# Shodan API Key
# SHODAN_API_KEY=your-shodan-api-key

# VirusTotal API Key
# VIRUSTOTAL_API_KEY=your-virustotal-api-key

# Censys API Key
# CENSYS_API_KEY=your-censys-api-key

# ----------------------------------------------------------------------------
# Backup & Maintenance
# ----------------------------------------------------------------------------
# Automatic backup schedule (cron format)
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# Advanced Settings
# ----------------------------------------------------------------------------
# Max concurrent scans
# MAX_CONCURRENT_SCANS=3

# Report retention (days)
# REPORT_RETENTION_DAYS=90

# Session timeout (seconds)
# SESSION_TIMEOUT=3600

# Max upload size (MB)
# MAX_UPLOAD_SIZE=100

# ----------------------------------------------------------------------------
# Directory Paths (optional - defaults to relative paths)
# ----------------------------------------------------------------------------
# These are auto-created if they don't exist
# Use absolute paths if you want to customize locations

# Config directory
# CONFIG_DIR=./config

# Database directory (for JSON files - PostgreSQL data is in volume)
# DATABASE_DIR=./database

# Logs directory
# LOGS_DIR=./logs

# Reports output directory
# REPORTS_DIR=./reports
