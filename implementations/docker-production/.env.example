# Docker Production Stack - Environment Variables

# Stack Name
STACK_NAME=sec-llama

# Database (PostgreSQL)
POSTGRES_DB=sec_llama
POSTGRES_USER=sec_llama
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b

# MCP Server
MCP_PORT=8765
MCP_API_KEYS=CHANGE_THIS_TO_SECURE_RANDOM_KEY

# Web UI
WEB_UI_PORT=8080
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_SECRET
DEBUG=false
LOG_LEVEL=INFO

# Nginx (Optional - Reverse Proxy)
NGINX_PORT=80
NGINX_HTTPS_PORT=443
DOMAIN=sec-llama.local

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# Scaling (replicas)
WEB_UI_REPLICAS=2
MCP_REPLICAS=2

# Resource Limits
WEB_UI_MEMORY_LIMIT=2G
WEB_UI_CPU_LIMIT=1.0
MCP_MEMORY_LIMIT=2G
MCP_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=4G
OLLAMA_MEMORY_LIMIT=16G

# Network
NETWORK_NAME=sec-llama-prod

# SSL/TLS (if using HTTPS)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
