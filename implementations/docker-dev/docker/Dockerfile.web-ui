# Multi-stage Dockerfile for Sec-Llama Web UI
# Stage 1: Build frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy frontend package files
COPY web_ui/frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy frontend source
COPY web_ui/frontend/ ./

# Build frontend
RUN npm run build

# Stage 2: Python backend with built frontend
FROM python:3.11-slim

LABEL maintainer="Sec-Llama <sec-llama@example.com>"
LABEL description="Sec-Llama Web UI - Configuration Interface for MCP Server"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    pydantic \
    python-multipart \
    websockets \
    pyyaml \
    httpx

# Copy application code
COPY web_ui/backend/ /app/web_ui/backend/
COPY config/ /app/config/
COPY modules/ /app/modules/
COPY mcp_server/ /app/mcp_server/

# Copy built frontend from stage 1
COPY --from=frontend-builder /app/frontend/dist/ /app/web_ui/backend/static/

# Create necessary directories
RUN mkdir -p /app/logs /app/reports /app/database /app/config/backups && \
    chmod 777 /app/logs /app/reports /app/database /app/config/backups

# Set Python path
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose Web UI port
EXPOSE 8080

# Start Web UI
CMD ["python3", "-m", "web_ui.backend.main", "--host", "0.0.0.0", "--port", "8080"]
