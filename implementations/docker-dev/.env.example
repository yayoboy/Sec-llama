# Docker Dev Environment Configuration

# Database
POSTGRES_DB=sec_llama
POSTGRES_USER=sec_llama
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b

# MCP Server
MCP_PORT=8765
MCP_API_KEYS=dev-api-key-change-me

# Web UI
WEB_UI_PORT=8080
FRONTEND_DEV_PORT=3000
SECRET_KEY=dev-secret-key-change-me

# Logging
LOG_LEVEL=DEBUG

# pgAdmin (Optional)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@sec-llama.local
PGADMIN_PASSWORD=admin
