# ================================================================================
# Sec-Llama - Production Environment Configuration
# ================================================================================
#
# IMPORTANTE:
# - Copia questo file in .env prima di avviare: cp .env.example .env
# - Modifica TUTTI i valori con "CAMBIAMI" o "CHANGE_ME"
# - Genera chiavi sicure con: openssl rand -hex 32
# - NON committare il file .env in Git!
#
# ================================================================================

# ================================================================================
# DEPLOYMENT MODE
# ================================================================================
# dev | production
DEPLOYMENT_MODE=production

# ================================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ================================================================================
POSTGRES_DB=sec_llama
POSTGRES_USER=sec_llama

# ⚠️ SECURITY: CAMBIARE QUESTA PASSWORD!
# Genera con: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD

POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Connection pool settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ================================================================================
# REDIS CONFIGURATION
# ================================================================================
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_DB=0

# ⚠️ SECURITY: CAMBIARE QUESTA PASSWORD!
# Genera con: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD

# Redis memory limit (for docker)
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ================================================================================
# LLM PROVIDER CONFIGURATION
# ================================================================================

# Provider: ollama | lm_studio
LLM_PROVIDER=ollama

# --- OLLAMA CONFIGURATION (Recommended) ---
# ⚠️ IMPORTANTE: Sostituisci 192.168.1.100 con l'IP del tuo PC Ollama
OLLAMA_HOST=http://192.168.1.100:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# Available models (uncomment to use):
# OLLAMA_MODEL=llama3.1:70b        # Migliore ma più lento
# OLLAMA_MODEL=mistral:latest      # Alternativa veloce
# OLLAMA_MODEL=codellama:latest    # Specializzato code review
# OLLAMA_MODEL=mixtral:latest      # Multi-task

# --- LM STUDIO CONFIGURATION (Alternative) ---
# Se usi LM Studio invece di Ollama, imposta LLM_PROVIDER=lm_studio
LM_STUDIO_HOST=http://192.168.1.100:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=not-needed

# ================================================================================
# APPLICATION SECURITY
# ================================================================================

# ⚠️ CRITICAL: GENERA CHIAVI RANDOM SICURE!
# Genera con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT Token expiration (seconds)
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ================================================================================
# DEFAULT ADMIN USER
# ================================================================================
# Questo utente viene creato automaticamente al primo avvio
# ⚠️ CAMBIARE LA PASSWORD AL PRIMO LOGIN!

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sec-llama.local
ADMIN_PASSWORD=ChangeMeOnFirstLogin123!

# ================================================================================
# APPLICATION SETTINGS
# ================================================================================

# Debug mode (ONLY for development! Set to false in production)
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Web UI port
WEB_UI_PORT=8080

# Workers for Uvicorn (auto = CPU cores, or specify number)
UVICORN_WORKERS=auto

# Max concurrent scans
MAX_CONCURRENT_SCANS=3

# ================================================================================
# CORS CONFIGURATION
# ================================================================================

# CORS allowed origins (comma-separated)
# ⚠️ SECURITY: In production, specifica domini esatti!
# Development: *
# Production: http://sec-llama.yourdomain.com,https://sec-llama.yourdomain.com
ALLOWED_ORIGINS=*

# ================================================================================
# RATE LIMITING
# ================================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API rate limits (requests per minute)
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_TOOLS=30

# ================================================================================
# SESSION CONFIGURATION
# ================================================================================

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# Session backend: redis | database
SESSION_BACKEND=redis

# ================================================================================
# FILE UPLOAD SETTINGS
# ================================================================================

# Max upload size (MB)
MAX_UPLOAD_SIZE=100

# Allowed file extensions (comma-separated)
ALLOWED_UPLOAD_EXTENSIONS=.py,.js,.java,.php,.go,.rb,.c,.cpp,.cs,.pcap,.cap,.log,.txt,.yaml,.yml,.json,.xml

# Upload directory
UPLOAD_DIR=/app/uploads

# ================================================================================
# REPORTS & OUTPUT
# ================================================================================

# Reports directory
REPORTS_DIR=/app/reports

# Report retention (days)
REPORT_RETENTION_DAYS=90

# Report formats: pdf,html,json,csv
REPORT_FORMATS=pdf,html,json

# ================================================================================
# BACKUP CONFIGURATION
# ================================================================================

# Automatic backup enabled
BACKUP_ENABLED=true

# Backup schedule (cron format)
# Default: Every day at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup directory
BACKUP_DIR=/app/backups

# ================================================================================
# NETWORK SCANNING CONFIGURATION
# ================================================================================

# Nmap path (container has nmap in PATH)
NMAP_PATH=/usr/bin/nmap

# Default scan timeout (seconds)
SCAN_TIMEOUT=300

# Max hosts per scan
MAX_HOSTS_PER_SCAN=255

# Default scan profile: quick | standard | thorough | stealth
DEFAULT_SCAN_PROFILE=standard

# ================================================================================
# EXTERNAL SERVICES (Optional)
# ================================================================================

# Shodan API Key (for enhanced threat intel)
# SHODAN_API_KEY=your-shodan-api-key-here

# VirusTotal API Key (for malware analysis)
# VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# Censys API credentials (for internet-wide scanning data)
# CENSYS_API_ID=your-censys-api-id
# CENSYS_API_SECRET=your-censys-api-secret

# AlienVault OTX API Key (for threat intelligence)
# OTX_API_KEY=your-otx-api-key-here

# ================================================================================
# EMAIL NOTIFICATIONS (Optional)
# ================================================================================

# Email notifications enabled
EMAIL_ENABLED=false

# SMTP server configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@sec-llama.local

# ================================================================================
# MONITORING & TELEMETRY (Optional)
# ================================================================================

# Application monitoring
MONITORING_ENABLED=false

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# Prometheus metrics endpoint
METRICS_ENABLED=false
METRICS_PORT=9090

# ================================================================================
# DOCKER-SPECIFIC SETTINGS
# ================================================================================

# Docker network subnet (change if conflicts with your network)
DOCKER_SUBNET=172.28.0.0/16

# Container restart policy: no | on-failure | always | unless-stopped
RESTART_POLICY=unless-stopped

# ================================================================================
# DEVELOPMENT SETTINGS (Only for dev mode)
# ================================================================================

# Hot reload enabled (only in dev)
HOT_RELOAD=false

# Frontend dev server (only in dev)
FRONTEND_DEV_PORT=5173

# API documentation enabled
API_DOCS_ENABLED=true

# Swagger UI path
SWAGGER_UI_PATH=/docs

# ReDoc path
REDOC_PATH=/redoc

# ================================================================================
# FEATURE FLAGS
# ================================================================================

# Enable/disable features
FEATURE_NETWORK_SCANNING=true
FEATURE_CODE_SCANNING=true
FEATURE_CVE_LOOKUP=true
FEATURE_WIRELESS_AUDIT=true
FEATURE_CONTAINER_SECURITY=true
FEATURE_API_FUZZING=true
FEATURE_LOG_ANALYSIS=true
FEATURE_THREAT_INTEL=true

# ================================================================================
# TIMEZONE
# ================================================================================

# Application timezone
TZ=Europe/Rome

# ================================================================================
# NOTES
# ================================================================================
#
# Quick Security Checklist:
# □ Changed POSTGRES_PASSWORD
# □ Changed REDIS_PASSWORD
# □ Generated SECRET_KEY (openssl rand -hex 32)
# □ Generated JWT_SECRET_KEY (openssl rand -hex 32)
# □ Changed ADMIN_PASSWORD
# □ Set correct OLLAMA_HOST IP
# □ Set DEBUG=false for production
# □ Set specific ALLOWED_ORIGINS for production
# □ Configured backup settings
#
# ================================================================================
