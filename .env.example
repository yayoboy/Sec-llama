# ========================================
# Sec-Llama - Environment Configuration
# ========================================

# ===================
# DATABASE SETTINGS
# ===================
POSTGRES_DB=sec_llama
POSTGRES_USER=sec_llama
POSTGRES_PASSWORD=CAMBIAMI_PASSWORD_SICURA_123
POSTGRES_PORT=5432

# ===================
# REDIS CACHE
# ===================
REDIS_PASSWORD=CAMBIAMI_REDIS_PASSWORD_456
REDIS_PORT=6379

# ===================
# LLM CONFIGURATION
# ===================
# Provider: ollama | lm_studio
LLM_PROVIDER=ollama

# Ollama Settings (se LLM_PROVIDER=ollama)
OLLAMA_HOST=http://192.168.1.100:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# LM Studio Settings (se LLM_PROVIDER=lm_studio)
LM_STUDIO_HOST=http://192.168.1.100:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=not-needed

# ===================
# SECURITY SETTINGS
# ===================
# IMPORTANTE: Genera chiavi random sicure!
# Usa: openssl rand -hex 32
SECRET_KEY=CAMBIAMI_GENERA_CHIAVE_RANDOM_32_CARATTERI
JWT_SECRET_KEY=CAMBIAMI_GENERA_JWT_KEY_32_CARATTERI

# Admin di default (modificare al primo login!)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sec-llama.local
ADMIN_PASSWORD=ChangeMeOnFirstLogin123!

# ===================
# APPLICATION
# ===================
DEBUG=false
LOG_LEVEL=INFO
WEB_UI_PORT=8080

# CORS (per ambienti di sviluppo usa *)
ALLOWED_ORIGINS=*

# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
